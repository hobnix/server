  "gateway": {
   "title": "Gateway proxy (Traefik: local names for the services)",
   "icon": "globe",
   "entry": true,
   "status": "gateway health",
   "apply": "gateway setup",
   "steps": [
    {
     "id": "connect",
     "title": "How connections arrive",
     "text": "A Cloudflare tunnel needs no open port. A router port forward opens 443 and 80 of this server to the internet.",
     "keys": [
      "reverseProxy",
      "gatewayTunnelPort",
      "gatewayPublicHttps",
      "gatewayPublicHttp"
     ],
     "presets": [
      {
       "id": "tunnel",
       "label": "Cloudflare tunnel",
       "set": {
        "reverseProxy": "traefik-public",
        "gatewayTunnelPort": "8081",
        "gatewayPublicHttps": "0",
        "gatewayPublicHttp": "0"
       }
      },
      {
       "id": "router",
       "label": "Router port forward",
       "set": {
        "reverseProxy": "traefik-public",
        "gatewayTunnelPort": "0",
        "gatewayPublicHttps": "443",
        "gatewayPublicHttp": "80"
       }
      }
     ]
    },
    {
     "id": "domain",
     "title": "Public domains",
     "text": "The names the internet uses to reach this server. The local domain and its wildcard record come from the Active Directory and are shown in the status above.",
     "keys": [
      "proxyDomains",
      "gatewayDirectDomains"
     ]
    },
    {
     "id": "certs",
     "title": "Certificates",
     "text": "Let's Encrypt certificates are requested either over HTTPS (TLS-ALPN-01, the default, port 443 must reach this server) or through Cloudflare DNS-01 (the API token is a credential, never a command argument). Use the staging service while you test.",
     "keys": [
      "gatewayAcmeEmail",
      "gatewayAcmeStaging",
      "gatewayAcmeChallenge",
      "gatewayAcmeDnsProvider"
     ],
     "presets": [
      {
       "id": "cloudflare",
       "label": "Cloudflare DNS-01",
       "set": {
        "gatewayAcmeChallenge": "dns",
        "gatewayAcmeDnsProvider": "cloudflare"
       }
      }
     ]
    },
    {
     "id": "auth",
     "title": "Login",
     "text": "The login is set per service, not for the whole gateway: open a service under Instances, Services and choose its login there.",
     "keys": []
    },
    {
     "id": "unknown",
     "title": "Unknown names",
     "text": "What a request for a name this server does not know gets as an answer, for the local and for the public side.",
     "keys": [
      "gatewayUnknownHostLocal",
      "gatewayUnknownHostPublic"
     ]
    }
   ]
  },
