# Machine-specific settings of this server.
#
# Copy to machine.toml and fill in your values; machine.toml is not committed.
# `hs config sync` (and so `hs update`) keeps your file in the layout of this one: same
# sections, same order, same comments. New options appear in their place, commented out; your
# values are kept. Compare with: diff machine.toml machine.toml.example
#
# One option per paragraph: a comment, then the option itself. A line that starts with "# name = "
# is an option that is off, and the value after it is only an example: remove the "# " to
# switch it on. Every option that is off has a default, so nothing breaks if you leave it.
# After editing: hs rebuild

# ═══ Server ═══════════════════════════════════════════════════════════════

# Name of the server: the Linux host name and the name Windows shows under "Network"
# (\\<hostName>). At most 15 characters.
hostName = "homeserver"

# What kind of node this machine is.
#   homeserver (default)  storage, Incus containers, Samba shares and backup: the capabilities storage, incus, samba and backup are on
#   edge                  a small public server (VPS) with the edge capabilities: mail entry, game ports, outside watcher, status document
#   minimal               only the base: users, SSH, hs, health check and push messages; add capabilities by name
# The base (adminuser, SSH, hs, health check, push messages) is on in every role. Needs a rebuild.
# role = "homeserver"

# Identifier ZFS needs, 8 hex characters. Create it once and never change it:
#   head -c4 /dev/urandom | od -A none -t x4
hostId = "CHANGEME"

# Time zone of the server, e.g. "Europe/Vienna" (list: `timedatectl list-timezones`). It sets the clock the
# logs, the timers (backup at 04:00, ...) and the time on the Matrix cards use, and the TZ of the film apps.
# Default: UTC, which is why a card can be hours off. After changing it run `hs recipe matrix-hook` and
# `hs recipe arr` again, so the containers pick it up.
# timeZone = "Europe/Vienna"

# SSH public keys that may log in as adminuser, one per PC
# (the contents of each PC's ~/.ssh/<key>.pub). Manage them with `hs ssh-key`.
sshKeys = [
  "ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIexample... you@pc",
]

# Optional parts of the server that are switched on, as a list of names (one folder each in
# capabilities/). Today: "metrics", and the extensions "games" and "posters" (`hs ext enable <name>`
# edits this list; a package without a Nix module needs no rebuild). A part whose old switch is set
# (for example metrics = true) counts as on even when it is not listed here. Otherwise needs a
# rebuild. docs/PLAN-modular-core.md, docs/PLAN-extensions.md
# capabilities = ["metrics"]

# ═══ Interface ════════════════════════════════════════════════════════════

# Keyboard layout of the console on the server itself (keyboard and screen), e.g. "de".
# Default: the US layout.
# keyMap = "de"

# The web interface (browser): one service on this server, reachable from the home networks
# and Tailscale, never from the internet. Only members of Domain Admins can sign in, and the
# local adminuser (the only way in while the storage is locked). Plain HTTP, so keep it off
# networks you do not trust. Default false. Needs a rebuild. docs/PLAN-web-backend.md
# webUi = true

# The port of the web interface. Default 8480. Needs webUi = true.
# webPort = 8480

# HTTPS for the web interface through Tailscale (`tailscale serve`): the page then listens on this
# server only and is reached at https://<host>.<your-tailnet>.ts.net from devices in your tailnet;
# the home-network port is closed. Needs once: `sudo tailscale up` on the server and "HTTPS
# certificates" switched on in the Tailscale admin console (DNS). Default false. Needs webUi = true
# and a rebuild.
# webTailscale = true

# Also open the web interface on the home network, by the server's address (plain HTTP, for
# example http://10.10.10.95:8480), next to the https address of webTailscale. Default true.
# Without webTailscale it is the only address on the home network anyway. With
# webTailscale on and webLan off the page is reachable only through Tailscale.
# webLan = false

# The guides and the command reference as a page of the web interface ("Docs", the capability docs).
# Built by `hs docs build` (`hs update` does it). Default true. Needs webUi = true and a rebuild.
# webDocs = false

# Live state for the web interface (the capability live-state): a collector reads `hs sys status` into Redis (unix socket only, nothing on
# disk) and the web serves it from there and pushes changes to the browser. "off" (the default) keeps the direct reads. Needs webUi = true and a rebuild.
# Not tested on hardware yet.
# liveState = "off"

# ═══ Network ══════════════════════════════════════════════════════════════

# The physical network card, check with `ip link`.
nic = "enp3s0"

# Subnets that may use the Samba shares, separated by spaces.
smbAllow = "10.10.10.0/24 127.0.0.1"

# Tagged VLANs for the Incus containers and VMs. The key is the name (at most 12 characters;
# it becomes the bridge "br-<name>" and an Incus profile). Exactly one VLAN must have
# `default = true`: new instances land there. A second one looks like this:
#   vlans = { home = { id = 95, default = true }, iot = { id = 30 } }
vlans = { home = { id = 95, default = true } }

# Which addresses of the container network the router hands out by DHCP: the last number,
# from and to. Fixed addresses should lie outside. Default [100, 199].
# dhcpRange = [100, 199]

# The label in front of the domain for this server's local names: the gateway proxy gives services
# <service>.<siteName>.<domain> (one wildcard record *.<siteName>, made by a person). Lower case
# letters, digits and hyphens. Default: hostName.
# siteName = "home"

# The Incus web UI (https://<server>:8443/ui/) and the network address of the Incus API.
#   true (default)  the UI works and `incus remote add` can reach the server
#   false           no UI, port 8443 closed, Incus listens on this machine only
# incusUi = true

# SSH (port 22) over the server's IP address from the home networks.
#   true (default)  `ssh adminuser@<ip or name>` works from any machine on the LAN
#   false           port 22 is closed on the network cards; SSH only through Tailscale (needs tailscaleRouter or webTailscale)
# sshOverIp = true

# Reach the home networks (admin pages, shares) from outside through Tailscale: this server
# becomes a subnet router. Default false. After `hs rebuild` run once:
#   sudo tailscale up --advertise-routes=10.10.95.0/24,10.10.10.95/32 --accept-dns=false
# then approve the routes in the Tailscale admin console.
# tailscaleRouter = true

# ═══ Storage ══════════════════════════════════════════════════════════════

# How the data disks under /bulk are organised. Default "zfs".
#   "zfs"       a ZFS pool of mirror pairs: equal disks, always protected, snapshots
#   "snapraid"  single disks of any size, merged; the parity is updated every few hours
# Disks are added with `hs manage-pool` in both cases, never listed here.
# bulkType = "snapraid"

# How often the SnapRAID parity is updated, in hours. Default 24 (once a night at 03:00, so the
# disks can sleep the rest of the day); allowed 1 2 3 4 6 8 12 24.
# It starts at 03:00, so 4 means 03:00 07:00 11:00 15:00 19:00 23:00. New and changed files are
# unprotected until the next run; a run only works on what changed, but each run wakes every disk.
# Only for bulkType = "snapraid".
# syncEveryHours = 4

# Automatic ZFS snapshots of every share, hourly: the last 24 hours, 7 days and 4 weeks are
# kept. Default false. Only for bulkType = "zfs" (with "snapraid" the backup is the history).
# Snapshots hold deleted files, so they use space. Leave a share out with
# `hs share <share> auto off` (pelican-backups is out from the start). Get a file back with
# `hs share <share> snapshots`, then rollback.
# shareSnapshots = true

# Upper limit of the ZFS read cache (ARC) in GiB. Default 12; 0 means no limit. Without a limit
# ZFS takes nearly all of the RAM. The cache gives memory back when programs need it, so a limit
# only matters if you want that RAM for containers and VMs; a smaller cache means more reads
# from the disks. Applies after `hs rebuild` (the running value changes at once, a shrunk cache
# empties over time).
# zfsArcMaxGB = 12

# Let the spinning bulk, parity and backup disks go to sleep after this many minutes without
# access (hdparm -S). Default 0 = never. Saves power, noise and wear when the server is idle;
# SnapRAID setups gain most (only the disk with a file wakes). Costs 10 to 20 seconds on the first
# access after a sleep, and the disks of a mirror wake one after the other. SSDs, NVMe, the
# system disk and the `fast` pool are never touched. Above 20 the value rounds up to whole half
# hours (longest 5.5 hours = 330). Some drives (certain IronWolf firmware, USB cases) ignore it.
# Applies after `hs rebuild`; `hs disk spindown status` shows the power state.
# diskSpindownMinutes = 30

# ═══ Accounts ═════════════════════════════════════════════════════════════

# The Active Directory domain this server joins as a file server; share logins and groups then
# come from the domain. `realm` is the domain, `workgroup` its short name. `hs recipe domain`
# sets this up. After the rebuild join once:
#   sudo net ads join -U Administrator
# adDomain = { realm = "AD.HOME.LAN", workgroup = "HOME" }

# ═══ History and status ═══════════════════════════════════════════════════

# Hand out numbers about load, disks and pools and collect them with Prometheus ON THIS SERVER
# (127.0.0.1:9090 only), so the history has no gap while the storage is locked.
# `hs recipe monitoring` sets this itself and installs Grafana (and Loki) in a container that
# reads from it. Default false.
# metrics = true

# How many days Prometheus keeps its numbers. Default 30. Needs metrics = true.
# metricsDays = 30

# The most disk space (GB, on the system disk) Prometheus may use; whichever limit is reached
# first wins. Default 5. Needs metrics = true.
# metricsMaxGB = 5

# One small read-only status document (http://<server>:9740/status.json: network counters,
# pools, disk health, backup age, problems) for a Stream Deck, a wall monitor or Home
# Assistant. Home networks and Tailscale only, no secrets in it. Default false. Needs a rebuild.
# deckApi = true

# The public HTTPS port of the gateway proxy (extension passthrough: outside domains forwarded by SNI). 0 = off. Suggested 443: the
# router forwards the internet's 443 straight to the server. Another port (4443) only behind a router that translates ports. Never 80.
# Opens the port to the internet. Needs hs rebuild.
# gatewayPublicHttps = 443

# The public HTTP port of the gateway proxy (extension passthrough: outside domains forwarded by Host). 0 = off. Suggested 80: the
# router forwards the internet's 80 straight to the server; port 80 then also carries the local names, which refuse every source
# outside the home networks. Another port (8008) only behind a router that translates ports. Never 443. Opens the port to the
# internet. Needs hs rebuild.
# gatewayPublicHttp = 80

# What the gateway proxy does with a name it has no route for (asda.<site>.<realm>) when the request comes from a home network:
# "404" = Traefik's own 404 page, "drop" = close the connection where that is possible (the HTTPS entrypoints; plain HTTP
# answers 404 instead). The web interface answers only to <site>.<realm>. Needs hs rebuild.
# gatewayUnknownHostLocal = "404"

# What the gateway proxy does with a name it has no route for when the request comes from the internet (public ports):
# "drop" = close the connection on the public HTTPS port (plain HTTP answers 404), "404" = a 404 page; on the public HTTPS port
# "404" needs a certificate and is not accepted yet. Needs hs rebuild.
# gatewayUnknownHostPublic = "drop"

# The port cloudflared sends the public traffic to (reverseProxy = traefik-public). 0 = off. Open only to gatewayTunnelFrom.
# Needs hs rebuild.
# gatewayTunnelPort = 8081

# The addresses that may use gatewayTunnelPort: the cloudflared container (fixed address). Needs hs rebuild.
# gatewayTunnelFrom = [ "10.10.95.19/32" ]

# Let's Encrypt account address for the gateway's own certificates (direct mode: the router forwards 443 to this server,
# reverseProxy = traefik-public). Empty = off. Needs gatewayPublicHttps. Needs hs rebuild.
# gatewayAcmeEmail = "admin@example.org"

# Use Let's Encrypt's test service first (certificates browsers do not trust, generous limits). Set false once hs gateway status
# shows a staging certificate for every host. Needs hs rebuild.
# gatewayAcmeStaging = false

# ═══ Hardware ═════════════════════════════════════════════════════════════

# Graphics chip(s), for GPU use in containers (Jellyfin transcoding, Immich, ...): "nvidia",
# "amd" or "intel", or a list of them: ["nvidia", "intel"]. Without it no graphics driver is
# installed (a server without a card, a VM). Find out what is built in:
#   lspci | grep -iE 'vga|3d|display'
# gpu = "nvidia"

# Which NVIDIA driver branch, only with gpu = "nvidia". "stable" (default) is the current driver
# for RTX 20xx cards and newer. A GTX 10xx (Pascal), GTX 9xx (Maxwell) or Titan V needs
# "legacy_580": the newest branch that still supports them ("Driver Not Loaded" in the log
# of nvidia-container-toolkit-cdi-generator is the sign of a card the driver does not support).
# nvidiaDriver = "legacy_580"

# PCI devices that stay without a driver after every boot, listed by address (find it with
# `lspci`): hs-pci-bind attaches them early in the boot, before the pools are imported, and
# writes what the device looked like before and after to /var/lib/hs/pci-bind.log. For example
# the second chip of a 9300-16i SAS card. Default: none. Needs a rebuild.
# pciBind = ["0000:05:00.0"]

# Name of the Incus instance that is this server's domain controller. Only needed when it is
# neither "dc1" nor "dc2": hs finds those two by itself (dc1 first, a second server of a domain
# has dc2). Default: found automatically.
# dcName = "dc2"

# A UPS (battery backup) on this server, read through NUT: a clean shutdown when the battery is
# low or after `shutdownMinutes` on battery (0 = only when low), and push messages for power lost,
# power back and shutting down. Default off. Write just the driver as a string (`ups = "usbhid-ups"`)
# or a table; all keys are optional: `driver` (default usbhid-ups; find it with `nut-scanner -U`),
# `name` (default ups), `port` (default auto), `shutdownMinutes` (default 5), `lowBatteryPercent`
# (the charge the UPS calls low, only for drivers that allow it). Guide: docs/operations.md. Look: hs ups
# ups = { driver = "usbhid-ups", name = "ups", shutdownMinutes = 5 }

# Disk the GRUB bootloader goes on, for a machine that does not boot with systemd-boot from an EFI partition (a VPS:
# BIOS or UEFI with GRUB, ESP at /boot). Default "" = systemd-boot, as on the home server.
# bootDevice = "/dev/sda"

# SSH public keys of OTHER nodes that may ask this one for its status (`hs node status`). Each key gets the forced command
# scripts/node-remote.sh and nothing else (restrict): it runs the fixed words of that script, never a shell. On an edge node
# the keys belong to root (ssh port 2222, as `hs node add --kind vps` on the main node expects), otherwise to adminuser.
# `hs node key <name>` on the other node prints the public line. Default: none. 
# nodeKeys = ["ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIexample... hs-node"]

# ═══ Edge node (a public VPS, role = edge) ════════════════════════════════

# The mail domain this node is the MX for (the capability edge-mail). Mail for it is relayed to the mail server (edgeStalwartIp).
# edgeDomain = "example.org"

# The name of the MX record and of the certificate (an A record for it must exist before the first rebuild, and the reverse DNS
# of the VPS must match it). Not the name of the mail server behind it.
# edgeMxHost = "mx.example.org"

# Contact address for Let's Encrypt (the certificate of edgeMxHost is checked over port 80).
# edgeAcmeEmail = "you@example.org"

# Tailscale address of the mail server that receives the relayed mail and answers "does this recipient exist" (port 25).
# edgeStalwartIp = "100.64.0.10"

# Tailscale address of the game server host (pelican-wings) the game ports are forwarded to.
# edgeWingsIp = "100.64.0.11"

# The game port pool: ports and ranges ("25565-25579") forwarded to edgeWingsIp as TCP and UDP. It must be the same pool as the
# allocations in Pelican and the same ports as the Tailscale ACL allows for this node. Never 22, 25, 80 or 41641.
# edgeGamePorts = ["25565-25579", "2456-2470"]

# Game ports that need only TCP (rare), on top of edgeGamePorts.
# edgeGameTcp = ["27015"]

# Game ports that need only UDP (rare), on top of edgeGamePorts.
# edgeGameUdp = ["27016"]

# Tailscale address of the LiveKit container (Matrix calls). Empty: the call ports are not forwarded.
# edgeRtcIp = "100.64.0.12"

# TCP ports LiveKit advertises (forwarded to edgeRtcIp).
# edgeRtcTcp = ["7881"]

# UDP ports LiveKit advertises (forwarded to edgeRtcIp).
# edgeRtcUdp = ["50000-50100"]

# Public addresses the outside watcher must see answer (any answer but "none" or a 5xx counts). No admin pages here.
# The two push addresses (the home server's heartbeat topic to watch, and the topic to alarm on) are secrets:
# `hs config set heartbeatUrl ...` and `hs config set notifyUrl ...` (files in /var/lib/hs, never in the repository).
# edgeWatchSites = ["https://example.org", "https://wiki.example.org"]

# File with a reusable Tailscale auth key (mode 0600), read once at the first start so a headless server joins the tailnet by
# itself. Create the key in the admin console; with tailscaleTags it carries the tag. Default "" = join by hand (`sudo tailscale up`).
# tailscaleAuthKeyFile = "/var/lib/hs/tailscale-authkey"

# Tailscale tags this node asks for when it joins (for example ["tag:vps"]); the ACL in the admin console decides what a tag may reach.
# tailscaleTags = ["tag:vps"]
