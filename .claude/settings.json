{
  "model": "sonnet",
  "effortLevel": "medium",
  "permissions": {
    "deny": [
      "Read(./pkgs/hs-pool/target/**)",
      "Read(./result*)"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume|clear|compact",
        "hooks": [{ "type": "command", "command": "bash scripts/dev/session-context.sh" }]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Edit|Write|NotebookEdit|Bash|PowerShell",
        "hooks": [{ "type": "command", "command": "bash \"$CLAUDE_PROJECT_DIR/scripts/dev/guard-primary-checkout.sh\"" }]
      }
    ]
  }
}
